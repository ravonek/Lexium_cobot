format: "xrdf"

format_version: 2.0

default_joint_positions: 
  joint_1: 0.0
  joint_2: 0.0
  joint_3: 0.0
  joint_4: 0.0
  joint_5: 0.0
  joint_6_gripper_rotation: -0.0
  gripper_Revolute_1: 0.0
  gripper_Revolute_2: -0.0
  gripper_Revolute_5: 0.0
  gripper_Revolute_6: 0.0

cspace: 
  joint_names: 
    - "joint_1"
    - "joint_2"
    - "joint_3"
    - "joint_4"
    - "joint_5"
    - "joint_6_gripper_rotation"
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [10000.0, 10000.0, 10000.0, 10000.0, 10000.0, 10000.0]

world_collision: 
  geometry: "auto_generated_collision_sphere_group"

self_collision: 
  geometry: "auto_generated_collision_sphere_group"
  ignore: 
    {}

